# Copy to .env and change every password. NEVER commit .env.
# Use letters and digits only in passwords (they are passed through shell/psql in the init script).

# Postgres bootstrap superuser: used ONLY by the container init script, never by the app.
POSTGRES_DB=copilot
POSTGRES_USER=copilot_admin
POSTGRES_PASSWORD=change_me_admin

# Application roles created by docker/initdb/01_roles.sh
APP_RW_PASSWORD=change_me_app
ETL_RW_PASSWORD=change_me_etl
ANALYTICS_RO_PASSWORD=change_me_readonly
SOURCE_RO_PASSWORD=change_me_source

# Runtime
APP_ENV=dev
LOG_LEVEL=INFO

# LLM for the agents. none = deterministic fallbacks only. ollama = use the optional ollama service (profile "llm").
LLM_PROVIDER=none
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_S=120

# --- Authentication (required). Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_chars
# Separation of duties: false = nobody can approve a change they requested themselves.
ALLOW_SELF_APPROVAL=false

# --- Integrations (documented MOCK services run by docker compose; any Slack-compatible webhook / REST ticket API also works)
MOCK_TICKET_TOKEN=change_me_mock_ticket_token
